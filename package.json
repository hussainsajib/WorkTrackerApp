{
  "name": "work-tracker",
  "version": "1.0.0",
  "description": "Personal work tracker with reminders and pomodoro timer",
  "author": "Hussain Sajib",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.local.worktracker",
    "productName": "WorkTracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "WorkTracker-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "quill": "^2.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
